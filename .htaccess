# SIGAD · Apache / cPanel · endurecimiento base
# --------------------------------------------------------------------------

# No listar el contenido de los directorios
Options -Indexes

# Evita que se sirva index.php al pedir un directorio sin archivo (usa index.php)
DirectoryIndex index.php

# --- Cabeceras de seguridad (además de las que envía PHP) ---
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
    Header always unset X-Powered-By
    Header unset X-Powered-By
</IfModule>

# --- Bloquear acceso directo a archivos y carpetas sensibles ---
# Credenciales, esquema SQL y núcleo PHP no deben servirse nunca por HTTP.
<FilesMatch "(^\.|\.(sql|md|sh|json|lock|ini|log|bak|inc)$)">
    Require all denied
</FilesMatch>

RedirectMatch 404 (?i)^/config/
RedirectMatch 404 (?i)^/includes/
RedirectMatch 404 (?i)^/db/
RedirectMatch 404 (?i)^/tests/
RedirectMatch 404 (?i)^/\.git/

# --- Limitar el tamaño de subida a nivel de servidor (defensa DoS) ---
# 400 MB por tomo, igual que valida la aplicación.
<IfModule mod_php.c>
    php_value upload_max_filesize 400M
    php_value post_max_size 410M
</IfModule>
